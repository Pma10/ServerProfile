{
  "schemaVersion": 1,
  "id": "serverprofiles",
  "version": "${version}",
  "name": "Server Profiles",
  "description": "Automatically switches selected Minecraft client settings for each server.",
  "authors": ["Pma"],
  "contact": {
    "issues": "https://github.com/Pma10/ServerProfiles/issues",
    "sources": "https://github.com/Pma10/ServerProfiles"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.pma10.serverprofiles.client.ServerProfilesClient"
    ],
    "modmenu": [
      "io.github.pma10.serverprofiles.integration.modmenu.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_dep}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
