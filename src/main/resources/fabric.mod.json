{
  "schemaVersion": 1,
  "id": "serverprofile",
  "provides": ["serverprofiles"],
  "version": "${version}",
  "name": "ServerProfile",
  "description": "Automatically switches selected Minecraft client settings for each server.",
  "authors": ["Pma"],
  "contact": {
    "issues": "https://github.com/Pma10/ServerProfile/issues",
    "sources": "https://github.com/Pma10/ServerProfile"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.pma10.serverprofile.client.ServerProfileClient"
    ],
    "modmenu": [
      "io.github.pma10.serverprofile.integration.modmenu.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "serverprofile.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_min_version}",
    "minecraft": "${minecraft_dep}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
